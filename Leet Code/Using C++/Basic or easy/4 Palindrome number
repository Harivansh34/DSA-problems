class Solution {
public:
    bool isPalindrome(int x) {

        long long n=0;
        long long rev=0;
        long long num=x;
        
        while(x>0)
        {
            n=x%10;
            rev=(rev*10)+n;
            x=floor(x/10);
        }

        if(rev==num)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
};